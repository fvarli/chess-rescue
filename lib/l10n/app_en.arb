{
  "@@locale": "en",

  "appTitle": "Chess Rescue",
  "@appTitle": {
    "description": "Application title shown in OS task-switcher chrome and accessibility surfaces."
  },

  "introTitle": "One move saves the king.",
  "@introTitle": {
    "description": "Intro overlay headline."
  },

  "introBody": "Every board begins in danger.\nFind the rescue. Feel the relief.",
  "@introBody": {
    "description": "Intro overlay body — two short sentences on separate lines."
  },

  "introSecondary": "No timers. No lessons. Just the way out.",
  "@introSecondary": {
    "description": "Intro overlay tertiary supporting line."
  },

  "introCta": "Start rescue",
  "@introCta": {
    "description": "Intro overlay mint CTA button label."
  },

  "headlineSaveTheKing": "Save the king.",
  "@headlineSaveTheKing": {
    "description": "Danger-state headline shown when no piece is selected."
  },

  "headlineWhereWillItGo": "Where will it go?",
  "@headlineWhereWillItGo": {
    "description": "Headline shown when a piece is selected (selected state, or danger with a selection)."
  },

  "headlineRescued": "Rescued.",
  "@headlineRescued": {
    "description": "Headline shown after a successful rescue."
  },

  "headlineNotTheMove": "Not the move.",
  "@headlineNotTheMove": {
    "description": "Headline shown after a failed move."
  },

  "hintOnboardingOneMoveSaves": "One piece can answer this. Find it.",
  "@hintOnboardingOneMoveSaves": {
    "description": "First-run danger hint shown when no piece is selected. PR-11: pivoted from premise-restatement (the IntroOverlay's job now) to focus-cue-aligned direction — names the relationship (one piece, this threat) without naming the piece or prescribing an action."
  },

  "hintOnboardingFindRescue": "Find the rescue.",
  "@hintOnboardingFindRescue": {
    "description": "First-run hint shown when a piece is selected (or selected state)."
  },

  "hintOnboardingStillTrapped": "The king is still trapped.",
  "@hintOnboardingStillTrapped": {
    "description": "First-run hint shown after a failed attempt."
  },

  "hintTapHighlightedSquare": "Tap a highlighted square to move.",
  "@hintTapHighlightedSquare": {
    "description": "Post-onboarding hint shown when a piece is selected."
  },

  "completionFootnote": "The board is quiet now.",
  "@completionFootnote": {
    "description": "Quiet footnote shown beneath the success line on session completion."
  },

  "footerNextPuzzle": "Next puzzle  ↦",
  "@footerNextPuzzle": {
    "description": "Footer CTA after a rescue when the session has a next puzzle."
  },

  "footerAgain": "Again  ↻",
  "@footerAgain": {
    "description": "Footer CTA after a rescue when the session is complete (rotates to the next session)."
  },

  "footerTryAgain": "Try again  ↺",
  "@footerTryAgain": {
    "description": "Footer CTA shown after a failed move."
  },

  "footerReset": "Reset",
  "@footerReset": {
    "description": "Footer CTA shown in danger/selected states (resets the current puzzle)."
  },

  "puzzleCounter": "PUZZLE {current}/{total}",
  "@puzzleCounter": {
    "description": "Status pill counter — current puzzle number and total in the session.",
    "placeholders": {
      "current": { "type": "int" },
      "total": { "type": "int" }
    }
  },

  "puzzleP1StatusText": "▮ Active threat",
  "@puzzleP1StatusText": {
    "description": "P1 knight rescue — danger-state status pill message."
  },
  "puzzleP1DangerHint": "One piece can answer this. Find it.",
  "@puzzleP1DangerHint": { "description": "P1 danger hint. Names the relationship (one piece, this threat) without naming the piece or prescribing an action — the focus cue carries the deixis." },
  "puzzleP1FailureHint": "That move doesn't break the attack. Look for a check.",
  "@puzzleP1FailureHint": { "description": "P1 failure hint." },
  "puzzleP1SuccessExplanation": "THE KNIGHT STRIKES BACK",
  "@puzzleP1SuccessExplanation": { "description": "P1 success explanation (mono caps)." },

  "puzzleP2StatusText": "▮ In check",
  "@puzzleP2StatusText": { "description": "P2 take-the-checker — status pill." },
  "puzzleP2DangerHint": "The checker sits one step away.",
  "@puzzleP2DangerHint": { "description": "P2 danger hint." },
  "puzzleP2FailureHint": "The knight still gives check.",
  "@puzzleP2FailureHint": { "description": "P2 failure hint." },
  "puzzleP2SuccessExplanation": "THE CHECKER IS GONE",
  "@puzzleP2SuccessExplanation": { "description": "P2 success explanation." },

  "puzzleP3StatusText": "▮ Checked on the file",
  "@puzzleP3StatusText": { "description": "P3 block-the-file — status pill." },
  "puzzleP3DangerHint": "Checked straight down the file.",
  "@puzzleP3DangerHint": { "description": "P3 danger hint." },
  "puzzleP3FailureHint": "That doesn't block the check.",
  "@puzzleP3FailureHint": { "description": "P3 failure hint." },
  "puzzleP3SuccessExplanation": "THE FILE IS SEALED",
  "@puzzleP3SuccessExplanation": { "description": "P3 success explanation." },

  "puzzleP4StatusText": "▮ Checked on the diagonal",
  "@puzzleP4StatusText": { "description": "P4 seal-the-diagonal — status pill." },
  "puzzleP4DangerHint": "The long diagonal is loaded.",
  "@puzzleP4DangerHint": { "description": "P4 danger hint." },
  "puzzleP4FailureHint": "The diagonal is still open.",
  "@puzzleP4FailureHint": { "description": "P4 failure hint." },
  "puzzleP4SuccessExplanation": "THE DIAGONAL IS CLOSED",
  "@puzzleP4SuccessExplanation": { "description": "P4 success explanation." },

  "puzzleP5StatusText": "▮ Checked on the rank",
  "@puzzleP5StatusText": { "description": "P5 win-the-queen — status pill." },
  "puzzleP5DangerHint": "The queen has crashed the back rank.",
  "@puzzleP5DangerHint": { "description": "P5 danger hint." },
  "puzzleP5FailureHint": "The queen still gives check.",
  "@puzzleP5FailureHint": { "description": "P5 failure hint." },
  "puzzleP5SuccessExplanation": "THE QUEEN FALLS",
  "@puzzleP5SuccessExplanation": { "description": "P5 success explanation." },

  "puzzleA4StatusText": "▮ Hunted at the gate",
  "@puzzleA4StatusText": { "description": "A4 the-breakaway — status pill." },
  "puzzleA4DangerHint": "Your knight is cornered and the gate is under fire.",
  "@puzzleA4DangerHint": { "description": "A4 danger hint." },
  "puzzleA4FailureHint": "That slips away but strikes nothing. Hit back with a check.",
  "@puzzleA4FailureHint": { "description": "A4 failure hint." },
  "puzzleA4SuccessExplanation": "THE KNIGHT BREAKS FREE",
  "@puzzleA4SuccessExplanation": { "description": "A4 success explanation." },

  "puzzleB1StatusText": "▮ The line is open",
  "@puzzleB1StatusText": { "description": "B1 the-martyr — status pill." },
  "puzzleB1DangerHint": "The diagonal is loaded and the king stands bare.",
  "@puzzleB1DangerHint": { "description": "B1 danger hint." },
  "puzzleB1FailureHint": "That doesn't stand in the way. Throw a body on the line.",
  "@puzzleB1FailureHint": { "description": "B1 failure hint." },
  "puzzleB1SuccessExplanation": "A BODY FOR THE KING",
  "@puzzleB1SuccessExplanation": { "description": "B1 success explanation." },

  "puzzleB3StatusText": "▮ Held up by one piece",
  "@puzzleB3StatusText": { "description": "B3 remove-the-defender — status pill." },
  "puzzleB3DangerHint": "One defender is propping up the whole attack.",
  "@puzzleB3DangerHint": { "description": "B3 danger hint." },
  "puzzleB3FailureHint": "The attack still stands. Tear out its support.",
  "@puzzleB3FailureHint": { "description": "B3 failure hint." },
  "puzzleB3SuccessExplanation": "THE PROP IS GONE",
  "@puzzleB3SuccessExplanation": { "description": "B3 success explanation." },

  "puzzleB4StatusText": "▮ In check",
  "@puzzleB4StatusText": { "description": "B4 the-cross-check — status pill (independent of P2 to allow translator variation)." },
  "puzzleB4DangerHint": "You're in check — but you can answer in kind.",
  "@puzzleB4DangerHint": { "description": "B4 danger hint." },
  "puzzleB4FailureHint": "That doesn't break the check. Answer with a check of your own.",
  "@puzzleB4FailureHint": { "description": "B4 failure hint." },
  "puzzleB4SuccessExplanation": "CHECK MEETS CHECK",
  "@puzzleB4SuccessExplanation": { "description": "B4 success explanation." },

  "puzzleCC2StatusText": "▮ Mate is coming",
  "@puzzleCC2StatusText": { "description": "Sprint V1 CC2 bishop-captures-the-shield (Bxf7+ counter-check) — danger-state status pill." },
  "puzzleCC2DangerHint": "The queen is one step from sealing the king in.",
  "@puzzleCC2DangerHint": { "description": "CC2 danger hint — orients toward the queen's imminent mate threat without naming squares." },
  "puzzleCC2FailureHint": "That move doesn't break the threat. Strike at the other king.",
  "@puzzleCC2FailureHint": { "description": "CC2 failure hint — redirects the player toward the counter-check shape." },
  "puzzleCC2SuccessExplanation": "THE BISHOP CRASHES THROUGH",
  "@puzzleCC2SuccessExplanation": { "description": "CC2 success explanation — mono small-caps register." },

  "puzzleCAM1StatusText": "▮ In check",
  "@puzzleCAM1StatusText": { "description": "Sprint V1 CAM1 knight-takes-the-bishop (Nxh2 capture-attacker) — status pill (independent of other 'In check' strings to allow translator variation)." },
  "puzzleCAM1DangerHint": "A bishop is biting. Hit it back.",
  "@puzzleCAM1DangerHint": { "description": "CAM1 danger hint — names the checker piece type without coordinates, prompts a return strike." },
  "puzzleCAM1FailureHint": "The bishop is still there. Take it.",
  "@puzzleCAM1FailureHint": { "description": "CAM1 failure hint — redirects toward capturing the checking piece." },
  "puzzleCAM1SuccessExplanation": "THE KNIGHT TAKES THE BISHOP",
  "@puzzleCAM1SuccessExplanation": { "description": "CAM1 success explanation — mono small-caps register." },

  "settingsLanguage": "Language",
