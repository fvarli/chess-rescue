<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only launcher label so the local development build cannot be
         confused with the Google Play production install on the same device.
         This source set is merged into profile builds only; the release
         manifest keeps android:label="Chess Rescue". -->
    <application
        android:label="Chess Rescue Dev"
        tools:replace="android:label" />
</manifest>
